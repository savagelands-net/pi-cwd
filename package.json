    "pi",
    "cwd",
    "extension"
  ],
  "license": "MIT",
  "author": "savagelands-net",
  "homepage": "https://github.com/savagelands-net/pi-cwd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savagelands-net/pi-cwd.git"
  },
  "bugs": {
    "url": "https://github.com/savagelands-net/pi-cwd/issues"
  },
